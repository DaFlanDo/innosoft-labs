# База данных (async URL для SQLAlchemy)
DATABASE_URL="mysql+aiomysql://innosoft:innosoft_secret@localhost:3306/innosoft?charset=utf8mb4"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
# Обязателен, сгенерируйте: openssl rand -hex 32
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080

# MinIO
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="innosoft"

# Приложение
APP_PORT=8000
DEBUG=true
